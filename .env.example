TELEGRAM_BOT_TOKEN=replace-with-botfather-token
SHOPPING_INVITE_CODE=replace-with-a-random-code-at-least-12-characters

# Public HTTPS URL for Telegram Mini App (optional until tunnel is configured)
SHOPPING_WEB_URL=

# Optional: rules (default) or deepseek. Text transcripts leave the VPS when enabled.
SHOPPING_EXTRACTOR=rules
DEEPSEEK_API_KEY=

# Optional Groq audio transcription; actual key stays in an external secret file.
SHOPPING_SPEECH_PROVIDER=local
# GROQ_SECRET_FILE=/etc/family-shopping-bot/secrets/groq_api_key
